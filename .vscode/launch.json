{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 SARIQX Backend Engine: Debugger",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "python": "${workspaceFolder}/.venv/bin/python", 
            "args": [
                "main:app",
                "--host", "0.0.0.0",
                "--port", "8000",
                "--loop", "uvloop"
            ],
            "jinja": true,
            "justMyCode": true,
            "subProcess": true,
            "console": "integratedTerminal"
        }
    ]
}